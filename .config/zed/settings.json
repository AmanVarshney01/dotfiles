{
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "show_edit_predictions": true,
  "features": {
    "edit_prediction_provider": "zed"
  },
  "icon_theme": "Catppuccin Mocha",
  "vim_mode": false,
  "agent": {
    "always_allow_tool_actions": true,
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    },
    "default_profile": "write",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-thinking"
    },
    "version": "2"
  },
  // "cursor_shape": "block",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "project_panel": {
    "indent_size": 16,
    "auto_fold_dirs": false
  },
  "file_finder": {
    // "modal_max_width": "large"
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
      "quick_actions": false
    },
    "button": false,
    "font_family": "JetBrainsMono Nerd Font"
  },
  // "telemetry": {
  //   "diagnostics": false,
  //   "metrics": false
  // },
  "autosave": "on_focus_change",
  // "ui_font_size": 16,
  // "buffer_font_size": 16,
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
    // "selections_menu": false
  },
  "scrollbar": {
    "show": "never"
  },
  "scroll_beyond_last_line": "off",
  // "vertical_scroll_margin": 0,
  "cursor_blink": false,
  "gutter": {
    "line_numbers": false,
    "code_actions": false,
    "folds": false
  },
  "tabs": {
    "file_icons": true
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Catppuccin Espresso (Blur)"
  },
  "experimental.theme_overrides": {
    "unreachable.background": "#0C0C0C",
    "drop_target.background": "#0C0C0C",
    "background": "#0C0C0C",
    "panel.background": "#0C0C0C",
    "surface.background": "#0C0C0C",
    "title_bar.background": "#0C0C0C",
    "toolbar.background": "#0C0C0C",
    "status_bar.background": "#0C0C0C",
    "tab_bar.background": "#0C0C0C",
    "tab.inactive_background": "#0C0C0C",
    "elevated_surface.background": "#0C0C0C",
    "ghost_element.background": "transparent",
    "element.background": "transparent",
    "editor.foreground": "#D1D5DC",
    "text": "#D1D5DC",
    "text.muted": "#778298",
    "text.disabled": "#4A5565",
    "text.placeholder": "#778298",
    "terminal.background": "#0C0C0C",
    "tab.active_background": "#0C0C0C",
    "editor.background": "#0C0C0C",
    "editor.gutter.background": "#0C0C0C",
    "border": "#242424",
    "border.focused": "#242424",
    "border.selected": "#242424",
    "border.variant": "#242424"
  }
